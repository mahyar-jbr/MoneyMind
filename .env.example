# =====================================================
# MoneyMind — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# =====================================================

# --- MongoDB Atlas ---
# Get from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/moneymind?retryWrites=true&w=majority
MONGODB_DB=moneymind

# --- Google Cloud / Gemini ---
# Get from Google AI Studio or GCP console
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=./.gcloud/service-account.json

# --- Voyage AI (auto-embed) ---
# Atlas Vector Search uses Voyage by default in 2026
VOYAGE_API_KEY=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- MongoDB MCP server ---
# Set MCP_ENABLED=true once the agent is wired to use it
MCP_ENABLED=false
MCP_SERVER_URL=http://localhost:8002

# --- App URLs (local dev defaults) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8001

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info
