# =====================================================
# MoneyMind — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# =====================================================

# --- MongoDB Atlas ---
# Get from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/moneymind?retryWrites=true&w=majority
MONGODB_DB=moneymind

# --- Google Cloud Vertex AI (R2 — agent LLM is Vertex Gemini 2.5 Flash) ---
# The agent calls gemini-2.5-flash through Vertex AI (langchain-google-vertexai /
# ChatVertexAI), NOT the AI-Studio google-genai SDK. There is no GEMINI_API_KEY.
# Auth is ADC via a service-account JSON; the SA needs `roles/aiplatform.user`.
#
# LOCAL DEV: point GOOGLE_APPLICATION_CREDENTIALS at the JSON key file on disk.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./.gcloud/service-account.json
#
# PRODUCTION (Railway / any container): do NOT ship the JSON file. Instead set
# GOOGLE_APPLICATION_CREDENTIALS_JSON_B64 to the base64 of the service-account
# JSON. deploy/entrypoint.sh decodes it to /tmp at boot and points
# GOOGLE_APPLICATION_CREDENTIALS there. Base64 avoids the PEM-newline corruption
# that raw multi-line JSON suffers in env vars. (Raw GOOGLE_APPLICATION_CREDENTIALS_JSON
# is honored as a fallback but may be mangled — prefer the _B64 form.)
# Generate with:  base64 -i .gcloud/service-account.json | tr -d '\n'
# GOOGLE_APPLICATION_CREDENTIALS_JSON_B64=

# --- Voyage AI (embeddings) ---
# Embeddings are written explicitly on insert by the agent (voyage-3, 1024-dim);
# Atlas auto-embed is NOT enabled on this cluster. Vector search reads memories.embedding.
VOYAGE_API_KEY=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
# CLI-only bearer token for scripts like `make seed`.
# Get one from a signed-in dev page with `await getToken()` or from
# the Clerk session token in browser devtools cookies.
CLERK_JWT=

# --- MongoDB MCP server ---
# The agent lazy-spawns the MongoDB MCP server as a stdio subprocess
# (`npx -y mongodb-mcp-server@latest --readOnly`) on the first chat turn and
# exposes its read tools as `mongo_*`. No URL/port — it's a child process, not
# an HTTP service. Spawn failure degrades gracefully to the 11 native tools.
#   MONGODB_MCP_TRANSPORT  transport for the MCP client (default: stdio)
#   MONGODB_MCP_DISABLE=1  kill switch — skip the spawn entirely (native tools only)
# MONGODB_MCP_TRANSPORT=stdio
# MONGODB_MCP_DISABLE=

# --- App URLs (local dev defaults) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8001

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info
