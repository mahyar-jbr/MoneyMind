# =====================================================
# MoneyMind — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# =====================================================

# --- MongoDB Atlas ---
# Get from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/moneymind?retryWrites=true&w=majority
MONGODB_DB=moneymind

# --- Google Cloud Vertex AI (R2 — agent LLM is Vertex Gemini 2.5 Flash) ---
# Auth: ADC via service-account JSON pointed to by GOOGLE_APPLICATION_CREDENTIALS.
# Service account needs `roles/aiplatform.user` on the project.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./.gcloud/service-account.json

# --- Voyage AI (auto-embed) ---
# Atlas Vector Search uses Voyage by default in 2026
VOYAGE_API_KEY=

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
# CLI-only bearer token for scripts like `make seed`.
# Get one from a signed-in dev page with `await getToken()` or from
# the Clerk session token in browser devtools cookies.
CLERK_JWT=

# --- MongoDB MCP server ---
# Set MCP_ENABLED=true once the agent is wired to use it
MCP_ENABLED=false
MCP_SERVER_URL=http://localhost:8002

# --- App URLs (local dev defaults) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8001

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info
